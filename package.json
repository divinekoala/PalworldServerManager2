{
  "name": "palworld-server-manager",
  "version": "1.0.0",
  "description": "Manager for a Palworld dedicated server: auto save+shutdown when empty, and a web UI with passkey sign-in to start/stop the server (HTTPS via DuckDNS + Caddy).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test",
    "hash-password": "node scripts/hash-password.js",
    "passkey-invite": "node scripts/passkey-invite.js"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "cookie": "^2.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "license": "MIT"
}
